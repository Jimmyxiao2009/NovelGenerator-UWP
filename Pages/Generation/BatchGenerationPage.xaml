<Page
    x:Class="novelgen.Pages.Generation.BatchGenerationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PhoneBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PhoneAccentBrush}">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnBackClick"
                        Style="{StaticResource PhonePlainButtonStyle}"
                        Foreground="White" Padding="8,4">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock x:Name="HeaderText" Text="批量生成"
                               Style="{StaticResource PhoneAppHeaderTextStyle}" FontSize="18"/>
                    <TextBlock x:Name="TimerText" Text=""
                               Foreground="#80FFFFFF" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="12,10,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="OverallProgress" Value="0" Minimum="0" Maximum="100"
                             Foreground="{StaticResource PhoneAccentBrush}" Height="8"/>
                <TextBlock Grid.Column="1" x:Name="PercentText" Text="0%"
                           FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource PhoneAccentBrush}"/>
            </Grid>
            <TextBlock x:Name="StatusText" Text="准备中…" FontSize="13" Margin="0,3,0,0"
                       Foreground="{StaticResource PhoneSubtleBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,10,12,0">
            <TextBlock Text="并发" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource PhoneSubtleBrush}" Margin="0,0,6,0"/>
            <ComboBox x:Name="ConcurrencyBox" MinWidth="60" SelectionChanged="OnConcurrencyChanged"
                      Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13">
                <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/>
                <ComboBoxItem Content="12"/><ComboBoxItem Content="16"/><ComboBoxItem Content="24"/>
                <ComboBoxItem Content="32"/>
            </ComboBox>
            <TextBlock Text="自定义" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource PhoneSubtleBrush}" Margin="0,0,4,0"/>
            <TextBox x:Name="ConcurrencyInput" Width="48" InputScope="Number" Text="3"
                     TextAlignment="Center" FontSize="13" VerticalAlignment="Center"
                     KeyDown="OnConcurrencyInputKeyDown"/>
            <Button Content="应用" Click="OnConcurrencyApplyClick" Margin="4,0,0,0"
                    MinWidth="48" FontSize="13" Padding="8,2"/>
        </StackPanel>

        <Border Grid.Row="3" Margin="12,6,12,0" x:Name="AgentBorder" Visibility="Collapsed">
            <StackPanel x:Name="AgentPanel" Orientation="Horizontal"/>
        </Border>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="12,0,12,56">
            <StackPanel x:Name="VolumeListPanel"/>
        </ScrollViewer>

        <Border Grid.Row="4" VerticalAlignment="Bottom" Margin="12,0,12,12">
            <Button x:Name="CancelBtn" Content="取消生成" Click="OnCancelClick"
                    Height="44" FontSize="15" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="1" BorderBrush="#88AAAAAA">
                <Button.Background>
                    <SolidColorBrush Color="#BB333333"/>
                </Button.Background>
            </Button>
        </Border>
    </Grid>
</Page>
