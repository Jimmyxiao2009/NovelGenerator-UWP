<Page
    x:Class="novelgen.Pages.Generation.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PhoneBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PhoneAccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnBackClick"
                        Style="{StaticResource PhonePlainButtonStyle}"
                        Foreground="White" FontSize="20" Padding="12,8" Margin="0">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <TextBlock Grid.Column="1" Text="⑧ 合并" Style="{StaticResource PhoneAppHeaderTextStyle}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,8,0,0">
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource PhoneListItemSubtitleStyle}" Margin="12,4"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultPanel" Margin="0,0,0,8"/>
            </ScrollViewer>

            <CommandBar Grid.Row="2" Background="{StaticResource PhoneAccentBrush}">
                <AppBarButton x:Name="ComposeBtn" Icon="Globe" Label="开始合并" Click="OnComposeClick" Foreground="White"/>
                <AppBarSeparator Foreground="White"/>
                <AppBarButton x:Name="NextBtn" Icon="Save" Label="导出 →" Click="OnNextClick" Foreground="White" IsEnabled="False"/>
            </CommandBar>
        </Grid>
    </Grid>
</Page>
