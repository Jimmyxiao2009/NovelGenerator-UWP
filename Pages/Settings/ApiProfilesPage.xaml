<Page
    x:Class="novelgen.Pages.Settings.ApiProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:novelgen.Pages.Settings"
    xmlns:models="using:novelgen.Models"
    Background="{StaticResource PhoneBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PhoneAccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnBackClick"
                        Style="{StaticResource PhonePlainButtonStyle}"
                        Foreground="White" FontSize="20" Padding="12,8" Margin="0">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <TextBlock Grid.Column="1" Text="API 配置" Style="{StaticResource PhoneAppHeaderTextStyle}"/>
            </Grid>
        </Border>

        <ListView Grid.Row="1" x:Name="ProfileList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProfileClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ApiProfile">
                    <Border Style="{StaticResource PhoneListItemBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource PhoneListItemTitleStyle}"/>
                                <TextBlock Text="{x:Bind Model}" Style="{StaticResource PhoneListItemSubtitleStyle}"/>
                                <TextBlock Text="{x:Bind Url}" Style="{StaticResource PhoneListItemSubtitleStyle}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="›" FontSize="32"
                                       Foreground="{StaticResource PhoneSubtleBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" x:Name="EmptyHint"
                   Text="还没有 API 配置。点下方 ➕ 添加。&#10;&#10;建议至少配置一个 OpenAI 兼容接口（如 DeepSeek、SiliconFlow）。"
                   Style="{StaticResource PhoneListItemSubtitleStyle}"
                   Foreground="{StaticResource PhoneSubtleBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Margin="24,0"/>

        <CommandBar Grid.Row="2" Background="{StaticResource PhoneAccentBrush}">
            <AppBarButton Icon="Add" Label="添加" Click="OnAddClick" Foreground="White"/>
        </CommandBar>
    </Grid>
</Page>
