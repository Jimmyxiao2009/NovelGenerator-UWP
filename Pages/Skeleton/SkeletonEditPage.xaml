<Page
    x:Class="novelgen.Pages.Skeleton.SkeletonEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PhoneBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PhoneAccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnBackClick"
                        Style="{StaticResource PhonePlainButtonStyle}"
                        Foreground="White" FontSize="20" Padding="12,8" Margin="0">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <TextBlock Grid.Column="1" Text="③ 故事骨架 · 手动编辑" Style="{StaticResource PhoneAppHeaderTextStyle}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Editor" Margin="0,8,0,16"/>
            </ScrollViewer>

            <CommandBar Grid.Row="1" Background="{StaticResource PhoneAccentBrush}">
                <AppBarButton Icon="Add" Label="加卷" Click="OnAddVolumeClick" Foreground="White"/>
                <AppBarButton Label="加伏笔" Click="OnAddForeshadowingClick" Foreground="White">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE82D;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator Foreground="White"/>
                <AppBarButton Icon="Save" Label="保存" Click="OnSaveClick" Foreground="White"/>
            </CommandBar>
        </Grid>
    </Grid>
</Page>
