<Page
    x:Class="novelgen.Pages.Wizard.NewNovelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:novelgen.Models"
    Background="{StaticResource PhoneBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PhoneAccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnCancelClick"
                        Style="{StaticResource PhonePlainButtonStyle}"
                        Foreground="White" FontSize="20" Padding="12,8" Margin="0">
                    <SymbolIcon Symbol="Back"/>
                </Button>
                <TextBlock Grid.Column="1" Text="新书向导" Style="{StaticResource PhoneAppHeaderTextStyle}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,8,0,32">
                <TextBlock Text="书名" Style="{StaticResource PhoneSectionHeaderStyle}"/>
                <Border Style="{StaticResource PhoneListItemBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="标题（留空则由 AI 自动命名）" Style="{StaticResource PhoneLabelStyle}"/>
                        <TextBox x:Name="TitleBox" TextWrapping="NoWrap"
                                 PlaceholderText="例：剑出长安" Style="{StaticResource PhoneTextBoxStyle}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="你的想法" Style="{StaticResource PhoneSectionHeaderStyle}"/>
                <Border Style="{StaticResource PhoneListItemBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="剧情简介、主题、风格倾向" Style="{StaticResource PhoneLabelStyle}"/>
                        <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="160"
                                 PlaceholderText="例：凡人修仙、宗门废材逆袭、玄幻爽文" Style="{StaticResource PhoneTextBoxStyle}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="类型与风格" Style="{StaticResource PhoneSectionHeaderStyle}"/>
                <Border Style="{StaticResource PhoneListItemBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Genre（类型）" Style="{StaticResource PhoneLabelStyle}"/>
                        <ComboBox x:Name="GenreBox" SelectionChanged="OnGenreChanged"
                                  HorizontalAlignment="Stretch" DisplayMemberPath="Name"/>
                        <TextBlock Text="SubGenre（子类型）" Style="{StaticResource PhoneLabelStyle}"/>
                        <ComboBox x:Name="SubGenreBox" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="风格预设" Style="{StaticResource PhoneLabelStyle}"/>
                        <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="生成参数" Style="{StaticResource PhoneSectionHeaderStyle}"/>
                <Border Style="{StaticResource PhoneListItemBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="目标章节数" Style="{StaticResource PhoneLabelStyle}"/>
                        <TextBox x:Name="TargetChaptersBox" Text="20" InputScope="Number" Style="{StaticResource PhoneTextBoxStyle}"/>
                        <TextBlock Text="每章目标字数" Style="{StaticResource PhoneLabelStyle}"/>
                        <TextBox x:Name="TargetWordsBox" Text="2500" InputScope="Number" Style="{StaticResource PhoneTextBoxStyle}"/>
                        <TextBlock Text="目标卷数（0 = 由 AI 按节奏决定；建议 3-5 卷）" Style="{StaticResource PhoneLabelStyle}"/>
                        <TextBox x:Name="TargetVolumesBox" Text="0" InputScope="Number" Style="{StaticResource PhoneTextBoxStyle}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="世界观规模" Style="{StaticResource PhoneSectionHeaderStyle}"/>
                <Border Style="{StaticResource PhoneListItemBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="这些数字会作为硬性要求传给 AI（至少这么多）" Style="{StaticResource PhoneListItemSubtitleStyle}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                <TextBlock Text="人物数" Style="{StaticResource PhoneLabelStyle}"/>
                                <TextBox x:Name="WorldCharsBox" Text="3" InputScope="Number"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                <TextBlock Text="地点数" Style="{StaticResource PhoneLabelStyle}"/>
                                <TextBox x:Name="WorldLocsBox" Text="2" InputScope="Number"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,4,0">
                                <TextBlock Text="势力数" Style="{StaticResource PhoneLabelStyle}"/>
                                <TextBox x:Name="WorldFactionsBox" Text="2" InputScope="Number"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,4,0,0">
                                <TextBlock Text="规则数" Style="{StaticResource PhoneLabelStyle}"/>
                                <TextBox x:Name="WorldRulesBox" Text="3" InputScope="Number"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="使用的模型" Style="{StaticResource PhoneSectionHeaderStyle}"/>
                <Border Style="{StaticResource PhoneListItemBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="草稿 / 生成用" Style="{StaticResource PhoneLabelStyle}"/>
                        <ComboBox x:Name="DraftApiBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name"/>
                        <TextBlock Text="精修 / 审查用（可与草稿相同）" Style="{StaticResource PhoneLabelStyle}"/>
                        <ComboBox x:Name="PolishApiBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name"/>
                        <TextBlock x:Name="ApiHint" Text="" Style="{StaticResource PhoneListItemSubtitleStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PhoneListItemBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Foreground="#D6321A" TextWrapping="Wrap"/>
                        <Button Content="开始生成 →" Click="OnStartClick" Style="{StaticResource PhoneAccentButtonStyle}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
