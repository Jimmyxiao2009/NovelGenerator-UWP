<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ 色板（运行时由 App.xaml.cs 切换 Light/Dark） ═════════════ -->
    <SolidColorBrush x:Key="PhoneBackgroundBrush"      Color="#F2F2F2"/>
    <SolidColorBrush x:Key="PhoneChromeBrush"          Color="White"/>
    <SolidColorBrush x:Key="PhoneForegroundBrush"      Color="#222222"/>
    <SolidColorBrush x:Key="PhoneSubtleBrush"          Color="#999999"/>
    <SolidColorBrush x:Key="PhoneBorderBrush"          Color="#DDDDDD"/>
    <SolidColorBrush x:Key="PhoneAccentBrush"          Color="{ThemeResource SystemAccentColor}"/>
    <SolidColorBrush x:Key="PhoneAccentForegroundBrush" Color="White"/>
    <SolidColorBrush x:Key="PhoneDisabledBrush"        Color="#CCCCCC"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundBrush" Color="{ThemeResource SystemAccentColor}"/>

    <!-- ═══ 字号 / 边距 ═══════════════════════════════════════════ -->
    <x:Double x:Key="PhoneFontSizeSmall">12</x:Double>
    <x:Double x:Key="PhoneFontSizeBody">15</x:Double>
    <x:Double x:Key="PhoneFontSizeMedium">18</x:Double>
    <x:Double x:Key="PhoneFontSizeLarge">24</x:Double>
    <x:Double x:Key="PhoneFontSizeExtraLarge">32</x:Double>
    <x:Double x:Key="PhoneFontSizeHuge">48</x:Double>

    <Thickness x:Key="PhoneMargin">12,12,12,12</Thickness>
    <Thickness x:Key="PhoneHorizontalMargin">12,0</Thickness>
    <Thickness x:Key="PhoneTightMargin">6,6,6,6</Thickness>

    <!-- ═══ 顶部应用栏 (WP7 风格的蓝条) ═══════════════════════════ -->
    <Style x:Key="PhoneAppBarHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PhoneAccentBrush}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
    </Style>

    <!-- ═══ 全宽列表项 ═══════════════════════════════════════════ -->
    <Style x:Key="PhoneListItemBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PhoneChromeBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PhoneBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,12,12,12"/>
    </Style>

    <Style x:Key="PhoneListItemTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeMedium}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneForegroundBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="PhoneListItemSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneSubtleBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="PhoneListItemDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ═══ 区块标题 ═════════════════════════════════════════════ -->
    <Style x:Key="PhoneSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneSubtleBrush}"/>
        <Setter Property="Margin" Value="12,16,12,4"/>
    </Style>

    <Style x:Key="PhoneTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeLarge}"/>
        <Setter Property="FontWeight" Value="SemiLight"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneForegroundBrush}"/>
    </Style>

    <Style x:Key="PhoneAppHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeExtraLarge}"/>
        <Setter Property="FontWeight" Value="SemiLight"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneAccentForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,8"/>
    </Style>

    <!-- ═══ 按钮 ═════════════════════════════════════════════════ -->
    <Style x:Key="PhoneAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PhoneAccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneAccentForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="PhonePlainButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeBody}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PhoneDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#D6321A"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeBody}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneAccentForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ═══ 输入控件 ═════════════════════════════════════════════ -->
    <Style x:Key="PhoneTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeBody}"/>
        <Setter Property="Padding" Value="6,8"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="{StaticResource PhoneBorderBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneForegroundBrush}"/>
    </Style>

    <Style x:Key="PhonePasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeBody}"/>
        <Setter Property="Padding" Value="6,8"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="{StaticResource PhoneBorderBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneForegroundBrush}"/>
    </Style>

    <!-- ═══ 标签 / 徽章 ═════════════════════════════════════════ -->
    <Style x:Key="PhoneLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneSubtleBrush}"/>
        <Setter Property="Margin" Value="0,8,0,2"/>
    </Style>

    <Style x:Key="PhoneBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PhoneBorderBrush}"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ═══ 兼容旧名 ═════════════════════════════════════════════ -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PhoneChromeBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PhoneBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,12"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="{StaticResource PhoneFontSizeSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PhoneSubtleBrush}"/>
        <Setter Property="Margin" Value="12,12,12,4"/>
    </Style>

</ResourceDictionary>
